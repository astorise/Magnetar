package magnetar:compute@1.1.0;

/// Portable Compute capability for coarse Provider-owned graph execution.
interface run {
  /// Stable tensor element kinds accepted at the Compute boundary.
  enum element-type {
    boolean,
    uint8,
    sint8,
    uint16,
    sint16,
    uint32,
    sint32,
    uint64,
    sint64,
    float16,
    brain-float16,
    float32,
    float64,
  }

  /// Semantic operation families inside the coarse Compute capability.
  enum operation-family {
    descriptor-and-view,
    construction-and-allocation,
    data-movement-and-conversion,
    elementwise,
    comparison-and-selection,
    reduction,
    linear-algebra,
    convolution-and-spatial-transform,
    indexing-and-update,
    random-generation,
    synchronization-and-completion,
  }

  /// Portable layout categories. Provider-native layout details stay opaque.
  enum layout-constraint {
    contiguous,
    strided,
    provider-opaque,
  }

  record tensor-descriptor-limits {
    max-rank: u64,
    max-dimension: u64,
    max-elements: u64,
    max-bytes: u64,
    allow-zero-sized: bool,
  }

  /// Portable precision policy categories for operation-family support.
  enum precision-mode {
    exact,
    default,
    reduced,
    mixed,
  }

  /// Provider advertisement for one operation family.
  record operation-family-support {
    family: operation-family,
    element-types: list<element-type>,
    provider-specific-element-types: list<string>,
    layouts: list<layout-constraint>,
    precision-modes: list<precision-mode>,
    descriptor-limits: tensor-descriptor-limits,
  }

  enum data-movement-kind {
    upload,
    download,
    copy,
    materialize,
    transfer,
    dtype-conversion,
    placement-conversion,
  }

  enum host-buffer-encoding {
    raw-bytes,
    native-endian,
    little-endian,
    big-endian,
  }

  record host-buffer-descriptor {
    byte-len: u64,
    encoding: host-buffer-encoding,
  }

  /// Provider advertisement for explicit tensor movement and conversion.
  record data-movement-support {
    kind: data-movement-kind,
    element-types: list<element-type>,
    provider-specific-element-types: list<string>,
    layouts: list<layout-constraint>,
    host-encodings: list<host-buffer-encoding>,
    descriptor-limits: tensor-descriptor-limits,
    allow-host-staging: bool,
  }

  /// Placeholder until future revisions define operation-specific schemas.
  record operation-descriptor {
    family: operation-family,
    element-type: option<element-type>,
    layout: option<layout-constraint>,
    precision: option<precision-mode>,
  }

  /// Tensor shape using fixed-width dimensions.
  record shape-descriptor {
    dimensions: list<u64>,
  }

  variant dtype-descriptor {
    portable(element-type),
    provider-specific(tuple<string, u64>),
  }

  /// Portable layout metadata. Strides and offsets are expressed in elements.
  variant layout-descriptor {
    contiguous,
    strided(tuple<list<s64>, u64>),
    provider-opaque(string),
  }

  variant view-source {
    descriptor,
    resource(string),
  }

  /// Tensor view metadata. A materialized copy is a separate tensor resource.
  record view-descriptor {
    source: view-source,
    offset-elements: u64,
    strides-elements: list<s64>,
  }

  /// Portable tensor metadata. Storage remains Provider-owned and opaque.
  record tensor-descriptor {
    shape: shape-descriptor,
    dtype: dtype-descriptor,
    layout: layout-descriptor,
    view: option<view-descriptor>,
  }

  record tensor-resource-descriptor {
    resource-id: string,
    descriptor: tensor-descriptor,
  }

  variant data-movement-source {
    host(host-buffer-descriptor),
    tensor(tensor-resource-descriptor),
  }

  record data-movement-descriptor {
    kind: data-movement-kind,
    source: data-movement-source,
    output: tensor-descriptor,
    target-provider: option<string>,
    target-device: option<string>,
    target-affinity-group: option<u64>,
    allow-host-staging: bool,
  }

  record graph-input {
    id: string,
    descriptor: tensor-descriptor,
    resource-id: option<string>,
  }

  variant graph-value-ref {
    input(string),
    node-output(tuple<string, string>),
  }

  record graph-node-output {
    id: string,
    descriptor: tensor-descriptor,
  }

  record graph-node {
    id: string,
    operation: operation-descriptor,
    inputs: list<graph-value-ref>,
    outputs: list<graph-node-output>,
  }

  record graph-output {
    id: string,
    source: graph-value-ref,
  }

  record graph-descriptor {
    id: string,
    inputs: list<graph-input>,
    nodes: list<graph-node>,
    outputs: list<graph-output>,
  }

  /// Stable error codes. Provider-specific detail belongs in diagnostics.
  enum compute-error-code {
    invalid-tensor-descriptor,
    invalid-shape,
    invalid-dtype,
    invalid-layout,
    size-overflow,
    invalid-graph,
    cyclic-graph,
    missing-input,
    missing-output,
    no-compatible-provider,
    policy-rejected-provider,
    provider-unavailable,
    device-unavailable,
    capability-version-mismatch,
    unsupported-operation,
    unsupported-operation-family,
    unsupported-dtype,
    unsupported-layout,
    unsupported-data-movement,
    incompatible-resource-affinity,
    provider-pinned-resource,
    device-bound-resource,
    artifact-fingerprint-mismatch,
    affinity-group-mismatch,
    execution-failed,
    execution-interrupted,
    execution-cancelled,
    operation-timeout,
    out-of-memory,
    resource-exhausted,
    invalid-host-buffer,
    invalid-transfer,
    unsupported-conversion,
    materialization-required,
    invalid-state,
    internal,
  }

  enum compute-error-phase {
    validation,
    resolution,
    affinity-validation,
    submission,
    execution,
    cancellation,
    completion,
    interruption,
  }

  enum compute-error-severity {
    recoverable,
    terminal,
    fatal,
  }

  enum recovery-hint {
    not-retryable,
    retry-before-state,
    restartable-with-replay,
    explicit-transfer-required,
    explicit-materialization-required,
    provider-pinned,
  }

  record compute-diagnostic {
    provider-id: option<string>,
    device-id: option<string>,
    capability-id: option<string>,
    operation-family: option<operation-family>,
    rejected-candidate-ids: list<string>,
    backend-message: option<string>,
    debug-trace-id: option<string>,
  }

  /// Structured compute failure with optional redacted diagnostics.
  record compute-error {
    code: compute-error-code,
    phase: compute-error-phase,
    severity: compute-error-severity,
    message: string,
    diagnostics: list<compute-diagnostic>,
    recovery-hints: list<recovery-hint>,
  }

  /// Non-terminal and terminal lifecycle states for submitted work.
  enum operation-state {
    submitted,
    running,
    completed,
    cancelled,
    failed,
  }

  /// Opaque tensor resource owned by the selected Provider.
  resource tensor {
    /// Return portable metadata for this tensor.
    descriptor: func() -> tensor-descriptor;
  }

  /// Opaque compute graph or batch resource owned by the selected Provider.
  resource graph {}

  /// Submitted compute work pinned to the Provider that owns its resources.
  resource operation {
    /// Return the current operation state without blocking for completion.
    status: func() -> operation-state;

    /// Wait until the operation reaches a terminal state.
    await-completion: func() -> result<operation-state, compute-error>;

    /// Request cancellation when the Provider can safely cancel the work.
    cancel: func() -> result<_, compute-error>;

    /// Transfer completed output tensor resources. Valid at most once.
    take-outputs: func() -> result<list<tensor>, compute-error>;
  }

  /// Submit coarse compute work represented by an opaque graph and inputs.
  submit: func(
    graph: borrow<graph>,
    inputs: list<borrow<tensor>>,
  ) -> result<operation, compute-error>;
}

world compute {
  export run;
}
